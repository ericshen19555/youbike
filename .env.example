# YouBike API Configuration
# No key required for the public JSON API provided

# Notification Settings
# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Telegram Chat ID (your chat ID or group ID)
TELEGRAM_CHAT_ID=your_chat_id_here

# LINE Notify Token
LINE_NOTIFY_TOKEN=your_line_notify_token_here

# Redis Settings (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# Monitoring Settings
# Station ID to monitor
TARGET_STATION_IDS=2001,2002
# Threshold for alert (alert if sbi <= THRESHOLD)
ALERT_THRESHOLD=3
# Check interval in seconds
CHECK_INTERVAL=60
